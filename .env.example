# Copy to .env and fill in. Never commit .env.
# Free key from https://api-v3.mbta.com (optional: without it you get about 20 requests per minute,
# which is enough for the default 10 second polling interval).
MBTA_API_KEY=

# Bus routes to watch, comma separated.
MBTA_ROUTES=1,15,22,23,28,39,57,66,111,116

# Set to true to re-run detection over everything still retained in Kafka.
DETECTOR_REPLAY_FROM_BEGINNING=false
